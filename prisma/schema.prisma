generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum Difficulty {
    EASY
    MEDIUM
    HARD
}

model Tour {
    id Int @id @default(autoincrement())
    name String
    duration Int
    difficulty Difficulty
    rating Float
    numberOfParticipants Int
}

enum Role {
    USER
    ADMIN
}

model User {
    id Int @id @default(autoincrement())
    name String
    email String @unique
    passwordHash String
    role Role @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}